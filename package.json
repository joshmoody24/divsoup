{
  "name": "divsoup",
  "version": "1.0.0",
  "description": "A site that scans websites and gives them weird awards based on how cursed their HTML is.",
  "main": "index.js",
  "scripts": {
    "build": "esbuild src/generate_achievements_page.ts --bundle --platform=node --format=esm --target=node24 --outfile=/tmp/divsoup-generate-achievements-page.mjs && node /tmp/divsoup-generate-achievements-page.mjs && esbuild src/browser_app.ts --bundle --format=esm --target=es2022 --outfile=static_html/app.js",
    "check": "prettier --check . && tsc --noEmit && vitest run",
    "format": "prettier --write .",
    "serve": "npm run build && python3 -m http.server ${PORT:-8000} --directory static_html",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joshmoody24/divsoup.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/joshmoody24/divsoup/issues"
  },
  "homepage": "https://github.com/joshmoody24/divsoup#readme",
  "devDependencies": {
    "@types/node": "^25.9.2",
    "esbuild": "^0.27.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.7.4",
    "typescript": "^6.0.3",
    "vitest": "^3.2.6"
  },
  "private": true
}
