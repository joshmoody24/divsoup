<link phx-track-static rel="stylesheet" href={~p"/assets/home.css"} />

<div class="home-container">
  <div class="home-intro">
    <h1>divsoup</h1>

    <p>
      divsoup now runs as a single-page analyzer: paste HTML, run analysis locally in your browser, and get judged instantly.
    </p>
  </div>

  <section id="analyze-form">
    <fieldset>
      <legend>Analyze HTML</legend>
      <div class="form-group">
        <label for="html-input">Paste HTML</label>
        <textarea
          id="html-input"
          name="html"
          rows="14"
          placeholder="&lt;!doctype html&gt;&#10;&lt;html&gt;...&lt;/html&gt;"
        ></textarea>
      </div>
      <button type="button" id="submit" class="btn btn-primary" role="button">
        Analyze HTML
      </button>
    </fieldset>
  </section>

  <div id="analysis-results" class="analysis-results"></div>

  <p class="home-cta">
    Check out the <a href="/achievements">complete achievement list</a> to see what you can earn!
  </p>
</div>

<script>
  (() => {
    const input = document.getElementById("html-input");
    const submit = document.getElementById("submit");
    const results = document.getElementById("analysis-results");

    const rules = [
      {
        title: "Not like the other girls",
        hierarchy: "standard",
        description:
          "Page contains links to <a href=\"https://getbootstrap.com/\" target=\"_blank\">Bootstrap</a> CSS or JS",
        evaluate: ({doc}) =>
          doc.querySelector('link[href*="bootstrap"], script[src*="bootstrap"]') !== null
      },
      {
        title: "Form Fanatic",
        hierarchy: "standard",
        description:
          "Page has a <code>&lt;form&gt;</code> containing <strong>5</strong> or more different input types",
        evaluate: ({doc}) => {
          const forms = Array.from(doc.querySelectorAll("form"));
          if (forms.length === 0) return false;

          const inputTypes = new Set();
          for (const form of forms) {
            for (const el of form.querySelectorAll("input")) {
              inputTypes.add((el.getAttribute("type") || "text").toLowerCase());
            }
            if (form.querySelector("textarea")) inputTypes.add("textarea");
            if (form.querySelector("select")) inputTypes.add("select");
          }

          return inputTypes.size >= 5;
        }
      },
      {
        title: "Cross Platform",
        hierarchy: "standard",
        description:
          "Page contains stylesheet or script references for at least 2 major frameworks/platforms",
        evaluate: ({doc}) => {
          const text = Array.from(doc.querySelectorAll("link[href], script[src]"))
            .map((el) => (el.getAttribute("href") || el.getAttribute("src") || "").toLowerCase())
            .join("\n");

          const frameworks = [
            "bootstrap",
            "react",
            "vue",
            "angular",
            "svelte",
            "jquery",
            "htmx"
          ];
          return frameworks.filter((name) => text.includes(name)).length >= 2;
        }
      },
      {
        title: "Htmx enjoyer",
        hierarchy: "standard",
        description: "Page references HTMX via script or HTMX attributes",
        evaluate: ({doc}) =>
          doc.querySelector('script[src*="htmx"], [hx-get], [hx-post], [hx-put], [hx-delete]') !== null
      },
      {
        title: "SEO Sleazeball",
        hierarchy: "standard",
        description: "Page uses meta tags targeting search engine optimization",
        evaluate: ({doc}) =>
          doc.querySelector('meta[name="description"], meta[name="keywords"], meta[property^="og:"]') !== null
      },
      {
        title: "Favicon Fanatic",
        hierarchy: "standard",
        description: "Page includes a favicon reference",
        evaluate: ({doc}) => doc.querySelector('link[rel*="icon"]') !== null
      },
      {
        title: "Commentator in Chief",
        hierarchy: "standard",
        description: "Page contains at least one HTML comment",
        evaluate: ({rawHtml}) => /<!--[\s\S]*?-->/.test(rawHtml)
      },
      {
        title: "Hydra",
        hierarchy: "standard",
        description: "Page contains multiple heading levels",
        evaluate: ({doc}) => {
          const levels = new Set(
            Array.from(doc.querySelectorAll("h1,h2,h3,h4,h5,h6")).map((el) => el.tagName.toLowerCase())
          );
          return levels.size >= 3;
        }
      }
    ];

    const cardClass = (hierarchy) => {
      switch (hierarchy) {
        case "bronze":
          return "bronze";
        case "silver":
          return "silver";
        case "gold":
          return "gold";
        case "platinum":
          return "platinum";
        default:
          return "standard";
      }
    };

    const analyze = () => {
      const rawHtml = input.value || "";
      if (!rawHtml.trim()) {
        results.innerHTML =
          "<div class=\"terminal-alert terminal-alert-error\"><p>Please paste HTML to analyze.</p></div>";
        return;
      }

      const doc = new DOMParser().parseFromString(rawHtml, "text/html");
      const earned = rules.filter((rule) => {
        try {
          return rule.evaluate({doc, rawHtml});
        } catch (_e) {
          return false;
        }
      });

      if (earned.length === 0) {
        results.innerHTML =
          "<div class=\"terminal-alert\"><p>No achievements earned from the current pasted HTML.</p></div>";
        return;
      }

      results.innerHTML =
        "<h3>Achievements:</h3>" +
        earned
          .map(
            (achievement) => `
            <div class="terminal-card">
              <header class="${cardClass(achievement.hierarchy)}">${achievement.title}</header>
              <div>${achievement.description}</div>
            </div>
          `
          )
          .join("");
    };

    submit.addEventListener("click", analyze);
  })();
</script>
